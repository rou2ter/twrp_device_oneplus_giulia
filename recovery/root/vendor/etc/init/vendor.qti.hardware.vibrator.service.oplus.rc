on boot
    chown root root /sys/class/leds/vibrator/rtp
    chown root root /sys/class/leds/vibrator/vmax
    chown root root /sys/class/leds/vibrator/waveform_index

service vendor.qti.vibrator /vendor/bin/hw/vendor.qti.hardware.vibrator.service.oplus
    class hal
    user root
    group root input
    seclabel u:r:recovery:s0
